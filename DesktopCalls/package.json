{
  "name": "ussdapp-desktop-calls",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windows LiveKit call companion for USSD Manager",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "livekit-client": "2.24.0"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.ussdapp.desktopcalls",
    "productName": "USSD Manager Calls",
    "executableName": "USSDCalls",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "artifactName": "USSDCalls"
    }
  }
}

  <SolidColorBrush x:Key="ErrorBrush"     Color="#F87171"/>
  <SolidColorBrush x:Key="EndCallBrush"   Color="#DC2626"/>

  <SolidColorBrush x:Key="SuccessBrush"   Color="#22C55E"/>
  <SolidColorBrush x:Key="WarnBrush"      Color="#F59E0B"/>

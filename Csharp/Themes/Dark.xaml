  <SolidColorBrush x:Key="GrayBrush"    Color="#64748B"/>
  <SolidColorBrush x:Key="MutedBrush"   Color="#475569"/>

  <SolidColorBrush x:Key="AccentBrush"    Color="#3B82F6"/>
  <SolidColorBrush x:Key="AccentHover"    Color="#2563EB"/>
  <SolidColorBrush x:Key="AccentSoft"     Color="#1E3A5F"/>

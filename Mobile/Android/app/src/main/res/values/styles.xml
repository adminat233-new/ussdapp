<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:textColorPrimary">#E2E8F0</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="android:colorAccent">#3B82F6</item>
        <item name="android:colorControlNormal">#94A3B8</item>
        <item name="android:colorControlActivated">#3B82F6</item>
        <item name="android:colorControlHighlight">#1D3F73</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:editTextStyle">@style/AppEditText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#E2E8F0</item>
    </style>

    <style name="AppEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/edit_text_surface</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">#E2E8F0</item>
        <item name="android:textColorHint">#94A3B8</item>
    </style>
</resources>

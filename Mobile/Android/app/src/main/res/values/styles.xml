<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#17243A</item>
        <item name="android:textColorSecondary">#5B6B82</item>
        <item name="android:colorAccent">#315FC5</item>
        <item name="android:colorControlNormal">#5B6B82</item>
        <item name="android:colorControlActivated">#315FC5</item>
        <item name="android:colorControlHighlight">#DCE7FC</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:editTextStyle">@style/AppEditText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#17243A</item>
    </style>

    <style name="AppEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/edit_text_surface</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">#17243A</item>
        <item name="android:textColorHint">#718096</item>
    </style>
</resources>

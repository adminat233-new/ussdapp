# Copy this file to .env on the VPS and replace every example value.
# Do not commit .env or send its secrets in chat.
CALL_API_PORT=8080
CALL_ALLOWED_ORIGINS=https://adminat233-new.github.io
CALL_TRUST_PROXY=1

# Public client endpoint; DNS must point to this VPS and TLS must be valid.
LIVEKIT_PUBLIC_URL=wss://calls.example.com
# Private API endpoint, reachable only on the VPS host network.
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880

# Generate long random values; use the same credentials in livekit.yaml.
LIVEKIT_API_KEY=replace_with_random_api_key
LIVEKIT_API_SECRET=replace_with_random_secret
